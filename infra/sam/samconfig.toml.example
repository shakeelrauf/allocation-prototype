# Copy to samconfig.toml and adjust:
#   cp samconfig.toml.example samconfig.toml

version = 0.1

[default.deploy.parameters]
stack_name = "newton3-dev"
resolve_s3 = true
s3_prefix = "newton3"
region = "eu-west-1"
confirm_changeset = false
capabilities = "CAPABILITY_IAM"
parameter_overrides = "Stage=dev BedrockModelId=anthropic.claude-3-5-haiku-20241022-v1:0 LlmBackend=bedrock"
image_repositories = []

[default.build.parameters]
cached = true
parallel = true
